Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Development metadata and runtime artifacts must never be web-accessible.
    RewriteRule ^(?:\.git|storage)(?:/|$) - [R=404,L,NC]

    # Keep browser-facing page URLs clean without disrupting POST requests.
    RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
    RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.php(?:[?\s]) [NC]
    RewriteRule ^index\.php$ /%1 [R=301,L,NE]

    RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.php(?:[?\s]) [NC]
    RewriteRule ^(.+)\.php$ /%1 [R=301,L,NE]

    # Resolve extensionless requests internally to their existing PHP pages.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [END,QSA]
</IfModule>

# Never serve local secrets, repository metadata, database dumps, or archives.
<FilesMatch "(^\.env(?:\..*)?$|^\.git|^composer\.(?:json|lock)$|\.(?:sql|zip|bak|ini|log)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header always unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
    Header always set Cross-Origin-Resource-Policy "same-origin"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
</IfModule>
