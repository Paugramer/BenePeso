Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Development metadata and runtime artifacts must never be web-accessible.
    RewriteRule ^(?:\.git|storage)(?:/|$) - [R=404,L,NC]
</IfModule>

# Never serve local secrets, repository metadata, database dumps, or archives.
<FilesMatch "(^\.env(?:\..*)?$|^\.git|^composer\.(?:json|lock)$|\.(?:sql|zip|bak|ini|log)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header always unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
    Header always set Cross-Origin-Resource-Policy "same-origin"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
</IfModule>
