# Local secrets and hosting configuration
.env
.env.*
!.env.example
config.local.php

# User-uploaded personal files
uploads/*
!uploads/.gitkeep
!uploads/.htaccess

# Local database and code backups must remain outside version control.
_safety_backups/*

# Composer installs PHP dependencies during deployment. Keep the standalone
# browser PDF library, which is not managed by Composer.
vendor/*
!vendor/pdf-lib/
vendor/pdf-lib/*
!vendor/pdf-lib/pdf-lib.min.js

# Local/editor files
.vscode/
.idea/
Thumbs.db
.DS_Store
