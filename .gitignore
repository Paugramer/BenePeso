# Local secrets and hosting configuration
.env
.env.*
!.env.example
config.local.php

# User-uploaded personal files
uploads/*
!uploads/.gitkeep
!uploads/.htaccess
/uploads*.zip

# Local database and code backups must remain outside version control.
_safety_backups/*

# Composer installs PHP dependencies during deployment. Keep the standalone
# browser PDF library, which is not managed by Composer.
vendor/*
!vendor/pdf-lib/
vendor/pdf-lib/*
!vendor/pdf-lib/pdf-lib.min.js

# Local/editor files
.vscode/
.idea/
Thumbs.db
.DS_Store

# Private runtime sessions, audit screenshots, and local browser profiles
/storage/
__pycache__/

# Microsoft Office temporary lock files
~$*

# Local research paper and revision documents
/deliverables/FINAL-PAPER-BENEPESO_REVISED.docx
/deliverables/BenePeso_Paper_Review.docx
/deliverables/BenePeso_Paper_System_Review.md
/deliverables/BenePeso_Replacement_Text.md
/deliverables/BenePeso_Revised_Paper_Pending_Checks.md
